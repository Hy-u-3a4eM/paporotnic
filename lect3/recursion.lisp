;;;; recursion.lisp — задачи на рекурсивный вызов функции (Common Lisp)
;;;;
;;;; Запуск:  sbcl --script recursion.lisp
;;;; Программа спрашивает номер задачи (1–4), затем входные данные.
;;;;
;;;; По условию нельзя использовать циклы и массивы, поэтому здесь нет ни
;;;; LOOP/DO/DOTIMES/MAPCAR, ни векторов — только рекурсивные функции.

;;; Печать числа через пробел: перед первым числом пробел не ставится.
(defun say (x first)
  (format t "~:[ ~;~]~D" first x))

;;; ---------------------------------------------------------------------
;;; Задача 1. Дано натуральное число n. Выведите все числа от 1 до n.
;;; Идея: выводим текущее i и вызываем функцию для i+1, пока i < n.
;;; Рекурсивный вызов стоит последним (хвостовая рекурсия), поэтому SBCL
;;; не расходует стек и программа работает даже для n = 1 000 000.
(defun print-1-to-n (n &optional (i 1))
  (say i (= i 1))
  (when (< i n)
    (print-1-to-n n (1+ i))))

;;; ---------------------------------------------------------------------
;;; Задача 2. Выведите все числа от A до B включительно: по возрастанию,
;;; если A < B, иначе по убыванию.
;;; Идея: выводим A и делаем шаг на единицу в сторону B.
(defun print-a-to-b (a b &optional (first t))
  (say a first)
  (unless (= a b)
    (print-a-to-b (if (< a b) (1+ a) (1- a)) b nil)))

;;; ---------------------------------------------------------------------
;;; Задача 3. Сумма цифр натурального числа N (без строк и списков).
;;; Идея: последняя цифра — N mod 10, остальные цифры — N div 10.
(defun digit-sum (n)
  (if (< n 10)
      n
      (+ (mod n 10) (digit-sum (floor n 10)))))

;;; ---------------------------------------------------------------------
;;; Задача 4. Все простые делители n > 1 в порядке возрастания.
;;; Перебираем делители d = 2, 3, 4, ... Если d делит n, то d простое
;;; (все меньшие простые множители уже «вычеркнуты» из n), выводим его
;;; и делим n на d, пока делится. Перебор останавливается, когда d*d > n:
;;; тогда оставшееся n > 1 само простое. Число шагов не больше sqrt(n),
;;; то есть требование O(n) выполнено с запасом.

;;; Убирает из n все множители d: 360, 2 -> 45.
(defun strip-factor (n d)
  (if (zerop (mod n d))
      (strip-factor (floor n d) d)
      n))

(defun print-prime-divisors (n &optional (d 2) (first t))
  (cond ((= n 1))                              ; всё разложили
        ((> (* d d) n) (say n first))          ; остаток — простое число
        ((zerop (mod n d))
         (say d first)
         (print-prime-divisors (strip-factor n d) (1+ d) nil))
        (t (print-prime-divisors n (1+ d) first))))

;;; ---------------------------------------------------------------------
;;; Ввод и выбор задачи.

(defun ask (prompt)
  (format t "~A" prompt)
  (finish-output)
  (read))

(defun main ()
  (case (ask "Номер задачи (1-4): ")
    (1 (let ((n (ask "n = ")))
         (if (and (integerp n) (>= n 1))
             (print-1-to-n n)
             (format t "n должно быть натуральным"))))
    (2 (let* ((a (ask "A = "))
              (b (ask "B = ")))
         (print-a-to-b a b)))
    (3 (let ((n (ask "N = ")))
         (if (and (integerp n) (>= n 1))
             (format t "Сумма цифр: ~D" (digit-sum n))
             (format t "N должно быть натуральным"))))
    (4 (let ((n (ask "n = ")))
         (if (and (integerp n) (> n 1))
             (print-prime-divisors n)
             (format t "n должно быть больше 1"))))
    (t (format t "Нет такой задачи")))
  (terpri))

